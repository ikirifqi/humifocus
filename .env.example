# Firebase web app config as JSON, from Firebase console > Project settings > Your apps.
# Copy this file to `.env` and fill in your project's values, keeping the single quotes.
# In GitHub Actions, the same name is read from a repository variable.
PUBLIC_FIREBASE_CONFIG='{"apiKey": "", "authDomain": "your-project-id.firebaseapp.com", "projectId": "your-project-id", "storageBucket": "your-project-id.firebasestorage.app", "messagingSenderId": "", "appId": ""}'
